rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admins are listed in /admins/{email} (lower-case email as the document id).
    function signedInEmail() {
      return request.auth != null && request.auth.token.email_verified == true
        ? request.auth.token.email.lower()
        : '';
    }

    function isAdmin() {
      return signedInEmail() != '' && exists(/databases/$(database)/documents/admins/$(signedInEmail()));
    }

    match /admins/{email} {
      // A signed-in user may check their own entry; only admins can add or remove admins.
      allow read: if email == signedInEmail() || isAdmin();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Customers see only open sales. `sold` / `orderCount` are also updated by createOrder (admin SDK).
    match /sales/{saleId} {
      allow read: if resource.data.status == 'open' || isAdmin();
      allow write: if isAdmin();
    }

    // Orders are created only through the createOrder function.
    match /orders/{orderId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /counters/{docId} {
      allow read, write: if false;
    }
  }
}
